# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Generated markdown preview files
README_files/
README.html

# Diagnostics
diagnostics/

# AI-related files
.agents/
.claude/
plan.md
# Cross-chat work-queue scratch doc (paste-into-fresh-chat prompts). Kept local
# only; its durable content (audit-series index, Prompt A/A′ results) lives in
# faithfulness-audit-01-twm.md and ADR 0006.
docs/design/next-chats-handoff.md

# User-specific files
.venv/
docs/old
resources/
tuning_profile.json

# MOBO sweep artifacts — regenerated at the repo root by scripts/optimize_twm.py
/twm_mobo.db
/twm_pareto_arm*.json
# Archived Optuna study DBs (large binaries). The archived Pareto fronts (*.json)
# and READMEs stay tracked: they are the evidence base ADR 0006 cites (incl. the
# queued 77/87 candidate's parameters in run4 arm6).
docs/mobo-archive/**/*.db
# Python bytecode
scripts/__pycache__/